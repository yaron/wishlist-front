{
  "bindings": [
    {
      "authLevel": "function",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": [
        "post"
      ],
      "route": "unclaim/{id}"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "type": "cosmosDB",
      "name": "unclaimItemIn",
      "databaseName": "wishlists",
      "collectionName": "items-yarontal",
      "connectionStringSetting": "CosmosDbConnectionString",
      "direction": "in",
      "Id": "{id}",
      "PartitionKey": "{id}"
    },
    {
      "name": "unclaimItemOut",
      "type": "cosmosDB",
      "databaseName": "wishlists",
      "collectionName": "items-yarontal",
      "createIfNotExists": true,
      "connectionStringSetting": "CosmosDbConnectionString",
      "direction": "out"
    }
  ]
}
