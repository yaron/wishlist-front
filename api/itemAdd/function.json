{
  "bindings": [
    {
      "authLevel": "function",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": [
        "post"
      ]
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "name": "addItem",
      "type": "cosmosDB",
      "databaseName": "wishlists",
      "collectionName": "items-lijst",
      "createIfNotExists": true,
      "connectionStringSetting": "CosmosDbConnectionString",
      "direction": "out"
    }
  ]
}
